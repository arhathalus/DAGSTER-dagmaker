# Vendored IPASIR solver SOURCE is tracked (glucose/, maplesat/, lingeling/) so the
# build is standalone -- no fetch, no submodules. Only their build ARTIFACTS (all
# regenerable via the build_*.sh scripts) are ignored here.

# built shared libs + object files
libipasir*.so
*.o
*.or
*.a

# lingeling files generated by configure.sh + make (regenerated by build_lingeling.sh)
lingeling/makefile
lingeling/lglcfg.h
lingeling/lglcflags.h
# lingeling standalone binaries (our build only makes liblgl.a; these appear only on a full `make`)
lingeling/lingeling
lingeling/plingeling
lingeling/treengeling
lingeling/ilingeling
lingeling/blimc
lingeling/lglmbt
lingeling/lgluntrace
lingeling/lglddtrace
